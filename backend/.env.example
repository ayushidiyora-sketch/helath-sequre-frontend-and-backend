# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example (default local install): postgresql://postgres:YOUR_PASSWORD@localhost:5432/helath_secure?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/helath_secure?schema=public"

# JWT signing secret — MUST match the frontend AUTH_SECRET for cross-app session validation
# Generate with: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_to_a_long_random_string_at_least_32_chars"

# Access token TTL — matches frontend (12h)
JWT_TTL_SECONDS=43200

# CORS origin for the Next.js frontend in development
CORS_ORIGIN="http://localhost:3000"

# Server port
PORT=3001

# Seed-script super admin credentials (used once by prisma:seed)
SEED_SUPER_ADMIN_EMAIL="ayushi.diyora@sensussoft.com"
SEED_SUPER_ADMIN_PASSWORD="Demo!Pass1234"

# --- MFA / OTP email transport ---
# Pick ONE: Resend (easier, recommended) OR Gmail SMTP.
#
# Option A — Resend (https://resend.com):
#   1. Sign up at https://resend.com (free tier: 3,000 emails/mo)
#   2. Create an API key at https://resend.com/api-keys
#   3. Paste it below as RESEND_API_KEY (starts with "re_")
#   4. Leave EMAIL_FROM as onboarding@resend.dev for the free sandbox,
#      OR verify your own domain at https://resend.com/domains and use that.
RESEND_API_KEY=""
EMAIL_FROM="HealthSecure Portal <onboarding@resend.dev>"
#
# Option B — Gmail SMTP (only used if RESEND_API_KEY is empty):
#   1. Turn on 2FA on your Google account
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Generate a 16-character "App password" (pick "Mail" and any device label)
#   4. Paste it as SMTP_PASS below (no spaces — Google shows it as 4 groups of 4)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HealthSecure Portal <no-reply@healthsecure.local>"

# Roles that REQUIRE OTP after password (comma-separated). Patients are excluded.
MFA_REQUIRED_ROLES="super_admin,org_admin,compliance_manager,auditor,clinician"
# OTP code length (digits) and TTL (seconds)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
