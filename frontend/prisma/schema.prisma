// HealthSecure Portal — initial schema.
// Aligned with Section 7 of the Requirement Analysis: UUID PKs, organization_id
// discriminator on tenant-scoped tables, soft-delete on PHI surfaces,
// append-only audit_logs (handled later — not in this first migration).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenancy root
// ---------------------------------------------------------------------------

enum TenantType {
  hospital
  clinic
  diagnostic
  telemedicine
}

enum TenantTier {
  basic
  pro
  enterprise
}

enum TenantStatus {
  active
  trial
  suspended
  archived
}

model Organization {
  id               String        @id @default(uuid()) @db.Uuid
  /// Short slug used in cross-tenant URLs and break-glass forms (org_lakeside).
  slug             String        @unique
  name             String
  type             TenantType
  tier             TenantTier    @default(basic)
  status           TenantStatus  @default(active)
  region           String        @default("ap-south-1")
  /// Free-form JSON for per-tenant settings (branding, retention defaults, etc.)
  settings         Json          @default("{}")
  multiAzEnabled   Boolean       @default(false)
  crossRegionS3    Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  archivedAt       DateTime?

  users            User[]
  roles            Role[]
  departments      Department[]
  appointments     Appointment[]

  @@index([status])
  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Departments
// Group clinicians, set default appointment-slot lengths, support hierarchy.
// ---------------------------------------------------------------------------

model Department {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id])
  name               String
  description        String?
  /// Self-referencing parent for nested departments (e.g. Cardiology → Medicine).
  parentId           String?      @db.Uuid
  parent             Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           Department[] @relation("DepartmentHierarchy")
  /// Default appointment slot length in minutes.
  defaultSlotMinutes Int          @default(30)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([parentId])
  @@map("departments")
}

// ---------------------------------------------------------------------------
// Appointments
// Patient is captured as a string for now (the patient module isn't wired to
// the DB yet) — when patients become real User rows this becomes a FK.
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  confirmed
  no_show
  blocked
  cancelled
  completed
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  organization    Organization      @relation(fields: [organizationId], references: [id])
  /// Clinician for the slot. Required even for "blocked" rows so the slot
  /// is attributed to one person's calendar.
  clinicianId     String            @db.Uuid
  clinician       User              @relation(fields: [clinicianId], references: [id])
  /// Free-form patient name for the demo. Use null for "blocked" slots.
  patientName     String?
  patientEmail    String?
  startsAt        DateTime
  durationMinutes Int               @default(30)
  /// Room or "Telehealth" — free text for the demo.
  room            String?
  status          AppointmentStatus @default(confirmed)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([organizationId, startsAt])
  @@index([clinicianId, startsAt])
  @@index([status])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// PatientAssignment
// Links a patient to a clinician for ongoing care (panel relationship).
// Active rows have endedAt = null; "unassigning" sets endedAt to NOW().
// ---------------------------------------------------------------------------

model PatientAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @db.Uuid
  patient      User     @relation("PatientAssignments_patient", fields: [patientId], references: [id])
  clinicianId  String   @db.Uuid
  clinician    User     @relation("PatientAssignments_clinician", fields: [clinicianId], references: [id])
  /// Free-form role e.g. "primary", "specialist", "consulting". Optional.
  role         String?
  notes        String?
  startedAt    DateTime @default(now())
  /// Null while the assignment is active; stamped when removed.
  endedAt      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([patientId, endedAt])
  @@index([clinicianId, endedAt])
  @@map("patient_assignments")
}

// ---------------------------------------------------------------------------
// Clinical artifacts — Prescription, MedicalRecord, PatientDocument
// All three are PHI-bearing, soft-delete via deletedAt, audit-logged on every
// state-changing op. Status lifecycle:
//   draft → finalized (record / prescription)
//   pending_scan → clean / infected (document)
// ---------------------------------------------------------------------------

model Prescription {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @db.Uuid
  clinicianId      String   @db.Uuid
  organizationId   String   @db.Uuid
  drugName         String
  strength         String?
  /// e.g. "Oral", "IV", "Topical". Free-form for now.
  route            String?
  /// e.g. "Once daily", "BID", "TID", "QID", "PRN".
  frequency        String?
  /// e.g. "90 days", "30 days", "10 days".
  duration         String?
  /// Number of refills authorised. Stored as int for sortability.
  refills          Int      @default(0)
  /// Patient-facing instructions, surfaced on the patient prescriptions page.
  patientInstructions String?
  /// "draft" while editable, "finalized" once locked and dispensable.
  status           String   @default("draft")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  finalizedAt      DateTime?
  deletedAt        DateTime?

  @@index([patientId, status])
  @@index([clinicianId, status])
  @@map("prescriptions")
}

model MedicalRecord {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @db.Uuid
  clinicianId     String   @db.Uuid
  organizationId  String   @db.Uuid
  /// "SOAP" | "Progress" | "Discharge" | "Consult"
  template        String   @default("SOAP")
  /// SOAP / Progress note structured fields. Stored separately so clinicians
  /// can fill what they need without forcing a single freeform blob.
  subjective      String?
  objective       String?
  assessment      String?
  plan            String?
  /// Free-form body for templates that don't follow SOAP (Discharge/Consult).
  body            String?
  status          String   @default("draft")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  finalizedAt     DateTime?
  deletedAt       DateTime?

  @@index([patientId, status])
  @@index([clinicianId, status])
  @@map("medical_records")
}

model PatientDocument {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @db.Uuid
  /// User who uploaded — can be the patient themselves or a clinician.
  uploadedById    String   @db.Uuid
  organizationId  String   @db.Uuid
  name            String
  /// "Lab Report" | "Imaging" | "Prescription" | "Insurance" | "ID Proof" | "Other"
  category        String   @default("Other")
  mimeType        String?
  sizeBytes       Int      @default(0)
  /// base64 data URL — fine for the demo until S3 wires up.
  dataUrl         String?
  /// "pending_scan" | "clean" | "infected"
  scanStatus      String   @default("pending_scan")
  /// Whether the patient should see this document on their /patient/documents
  /// page (when uploaded by a clinician).
  sharedWithPatient Boolean @default(true)
  uploadedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([patientId, deletedAt])
  @@map("patient_documents")
}

// ---------------------------------------------------------------------------
// ConsentRequest
// Clinician asks a patient to grant access to specific record categories.
// Status lifecycle: pending → approved | declined | expired.
// ---------------------------------------------------------------------------

model ConsentRequest {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @db.Uuid
  clinicianId     String   @db.Uuid
  organizationId  String   @db.Uuid
  /// JSON array of scope keys: ["insurance","lab","imaging", ...]
  scopes          Json     @default("[]")
  durationHours   Int      @default(24)
  reason          String
  /// "pending" | "approved" | "declined" | "expired"
  status          String   @default("pending")
  requestedAt     DateTime @default(now())
  decidedAt       DateTime?
  decisionNote    String?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([patientId, status])
  @@index([clinicianId, status])
  @@map("consent_requests")
}

// Patient → family / dependants / caregivers. One row per relationship.
model FamilyMember {
  id                String   @id @default(uuid()) @db.Uuid
  patientId         String   @db.Uuid
  name              String
  /// "Spouse" | "Child" | "Parent" | "Sibling" | "Guardian" | "Other"
  relationship      String
  dob               DateTime? @db.Date
  isMinor           Boolean  @default(false)
  canManageAccount  Boolean  @default(false)
  phone             String?
  email             String?
  notes             String?
  addedAt           DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([patientId])
  @@map("family_members")
}

// One row per patient — emergency contact + critical-care data. Singleton on
// patientId (the API upserts on PATCH).
model PatientEmergency {
  id                    String   @id @default(uuid()) @db.Uuid
  patientId             String   @unique @db.Uuid
  primaryName           String   @default("")
  primaryRelationship   String   @default("")
  primaryPhone          String   @default("")
  secondaryName         String?
  secondaryRelationship String?
  secondaryPhone        String?
  /// "A+" | "A-" | "B+" | "B-" | "AB+" | "AB-" | "O+" | "O-" | "Unknown"
  bloodGroup            String   @default("Unknown")
  /// JSON arrays so the patient can free-form add multiple entries.
  allergies             Json     @default("[]")
  criticalMedications   Json     @default("[]")
  medicalIds            Json     @default("[]")
  organDonor            Boolean  @default(false)
  preferredHospital     String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@map("patient_emergency")
}

model InsurancePlan {
  id                     String   @id @default(uuid()) @db.Uuid
  patientId              String   @db.Uuid
  provider               String
  planName               String
  policyNumberMasked     String
  groupNumber            String?
  memberId               String?
  /// "Self" | "Family" | "Spouse" | "Children"
  coverageType           String   @default("Self")
  startDate              DateTime @db.Date
  endDate                DateTime? @db.Date
  isPrimary              Boolean  @default(false)
  cardFrontFileName      String?
  cardBackFileName       String?
  /// "none" | "pending" | "approved" | "denied"
  preAuthorizationStatus String   @default("none")
  notes                  String?
  addedAt                DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([patientId, isPrimary])
  @@map("insurance_plans")
}

model VaccinationRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  patientId           String   @db.Uuid
  vaccine             String
  manufacturer        String?
  doseNumber          Int      @default(1)
  totalDoses          Int?
  administeredOn      DateTime @db.Date
  administeredBy      String?
  lotNumber           String?
  nextDoseDue         DateTime? @db.Date
  certificateFileName String?
  forTravel           Boolean  @default(false)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([patientId, administeredOn])
  @@map("vaccination_records")
}

// Direct secure messages between a clinician and a patient. A "thread" is the
// implicit (clinicianId, patientId) pair — DISTINCT on that pair yields the
// thread list, ORDER BY sentAt DESC within a pair yields the conversation.
model Message {
  id              String   @id @default(uuid()) @db.Uuid
  clinicianId     String   @db.Uuid
  patientId       String   @db.Uuid
  organizationId  String   @db.Uuid
  /// "clinician" | "patient" — who authored this message.
  senderRole      String
  body            String
  /// JSON array of `{name, mimeType, size, dataUrl}` — embedded data URLs
  /// keep messaging self-contained without a separate blob store.
  attachments     Json     @default("[]")
  sentAt          DateTime @default(now())
  /// Stamped when the recipient opens the thread.
  readAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clinicianId, patientId, sentAt])
  @@index([patientId, readAt])
  @@index([clinicianId, readAt])
  @@map("messages")
}

// Super-Admin operational incidents. Manual rows created via the "Open
// incident" dialog; auto-derived rows (locked accounts, MFA exhaustion,
// infected uploads, suspended tenants) are computed at read-time and unioned
// into the Active/Closed lists — no separate row stored for those.
model Incident {
  id             String   @id @default(uuid()) @db.Uuid
  /// Auto-incrementing display number — rendered as "INC-NNNN".
  number         Int      @default(autoincrement())
  title          String
  /// "high" | "medium" | "minor"
  severity       String   @default("minor")
  /// "open" | "investigating" | "mitigating" | "monitoring" | "resolved"
  status         String   @default("open")
  /// e.g. "tenant:greenleaf" or "platform"
  scope          String?
  /// Null when opened by a demo Super Admin (no DB user row to FK against).
  openedBy       String?  @db.Uuid
  openedAt       DateTime @default(now())
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, openedAt])
  @@map("incidents")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  invited
  suspended
  deactivated
}

/// System role kinds. Per-tenant Role rows can extend these, but the kind
/// drives the route prefix and most policy checks.
enum RoleKind {
  patient
  clinician
  org_admin
  compliance_manager
  auditor
  super_admin
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  /// Null for super admins (cross-tenant Sensussoft staff).
  organizationId  String?      @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id])

  email           String       @unique
  /// bcrypt hash of the password
  passwordHash    String
  /// Encrypted TOTP secret. Null until MFA is enrolled.
  mfaSecret       String?
  mfaEnrolledAt   DateTime?

  firstName       String
  lastName        String
  phone           String?

  // --- Extended profile (HR / employment) ----------------------------------
  /// Free-form tenant-issued staff ID (e.g. "EMP-00481").
  employeeId      String?
  dateOfBirth     DateTime?    @db.Date
  /// "Male" | "Female" | "Other" | "Prefer not to say"
  gender          String?
  /// URL or filename for the uploaded profile photo (storage TBD).
  profilePhotoUrl String?
  /// Department label until a Department table exists.
  department      String?
  /// Job title (e.g., "Senior Staff Nurse").
  designation     String?
  /// "Standard" | "Elevated" | "Restricted"
  accessLevel     String?
  /// Free-form supervisor name (will become a self-FK once HR hierarchy lands).
  reportingTo     String?
  joiningDate     DateTime?    @db.Date
  /// "Full-time" | "Part-time" | "Contract"
  employmentType  String?
  /// "Morning" | "Evening" | "Night" | "Rotating"
  shift           String?
  workLocation    String?
  /// Per-user permission overrides. Defaults follow the role.
  /// Shape: { canViewPatients, canManageAppointments, canAccessRecords, canSendMessages }
  permissions     Json         @default("{}")
  /// Clinician weekly availability template. Shape:
  /// { Monday: { start: "09:00", end: "17:00", slotMinutes: 15, off: false }, ... }
  scheduleTemplate Json        @default("{}")
  /// Whether MFA is required on next sign-in.
  mfaRequired     Boolean      @default(true)

  roleKind        RoleKind
  /// Per-tenant Role override. Null means use the default kind.
  roleId          String?      @db.Uuid
  role            Role?        @relation(fields: [roleId], references: [id])

  status          UserStatus   @default(active)
  lastLoginAt     DateTime?
  /// Bumped on every authenticated heartbeat; used to compute "online"
  /// (heartbeat within last 2 minutes) on the messaging surface.
  lastActiveAt    DateTime?
  failedLoginCount Int         @default(0)
  lockedUntil     DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  sessions        Session[]
  appointments    Appointment[]
  /// Patient -> clinician panel assignments where this user is the patient.
  asPatientPanel  PatientAssignment[] @relation("PatientAssignments_patient")
  /// Patient -> clinician panel assignments where this user is the clinician.
  asClinicianPanel PatientAssignment[] @relation("PatientAssignments_clinician")

  @@index([organizationId])
  @@index([roleKind])
  @@index([status])
  @@index([department])
  @@map("users")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id              String       @id @default(uuid()) @db.Uuid
  /// Null for system roles (shared across all tenants).
  organizationId  String?      @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id])
  kind            RoleKind
  name            String
  description     String?
  createdAt       DateTime     @default(now())

  permissions     RolePermission[]
  users           User[]

  @@unique([organizationId, name])
  @@index([kind])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  /// e.g. "records:read", "documents:upload"
  code        String  @unique
  module      String
  description String

  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Sessions
// ---------------------------------------------------------------------------

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the refresh token. The raw token is only sent to the client.
  refreshTokenHash String @unique
  device       String?
  ipAddress    String?
  userAgent    String?
  issuedAt     DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// MFA challenges (email OTP after password — staff roles)
// ---------------------------------------------------------------------------

model MfaChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  /// SHA-256 of the 6-digit code. Raw code only ever lives in the email.
  codeHash    String
  attemptsLeft Int      @default(5)
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  ipAddress   String?
  userAgent   String?

  @@index([userId])
  @@index([expiresAt])
  @@map("mfa_challenges")
}
